# ==========================================
# GitHub Issue Fetcher Agent Configuration
# ==========================================

# Target GitHub Repository Owner (User or Organization)
# Example: OWNER="octocat" or OWNER="your-username"
OWNER="your_github_username_or_org"

# Target GitHub Repository Name
# Example: REPO="Hello-World" or REPO="your-repo-name"
REPO="your_repository_name"

# GitHub Personal Access Token (Classic or Fine-grained)
# Required for authenticated API calls and higher rate limits (5,000 requests/hour).
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_yourPersonalAccessTokenHere"
